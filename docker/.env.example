# ── NeuroPlant AI — environment template ─────────────────────────────────
# Copy to `.env` (in the docker/ dir or project root) and fill in real values.
# Never commit real secrets.

# App
ENVIRONMENT=development            # development | staging | production
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:4173

# Database (compose overrides with the postgres URL)
# DATABASE_URL=postgresql+asyncpg://neuroplant:neuroplant@localhost:5432/neuroplant
# DATABASE_URL=sqlite+aiosqlite:///./neuroplant.db   # native dev fallback
DB_ECHO=false

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# Auth (M1) — MUST be changed in any non-dev environment
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# Rate limiting
RATE_LIMIT_ENABLED=false

# Storage
STORAGE_PROVIDER=local            # local | s3
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=neuroplant
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=http://localhost:9000

# External providers (optional — graceful degrade when blank)
GOOGLE_PROJECT_ID=
GOOGLE_CREDENTIALS_JSON=
OPENWEATHER_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LLM_API_KEY=
LLM_PROVIDER=anthropic
