# NeuroPlant AI — Frontend image
# Builds the Vite app, then serves it with nginx (which also reverse-proxies
# /api and /ws to the API service). Build context: repo ROOT.

FROM node:22-alpine AS build
WORKDIR /app
# If a package-lock.json is committed, use `npm ci` for reproducible builds.
COPY frontend/package.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine AS serve
COPY docker/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
